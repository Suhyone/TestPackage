# คัดลอกเป็น .env แล้วใส่ค่าจริงจาก Supabase > Project Settings > API   (ห้ามนำ .env ขึ้นที่สาธารณะ)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# คีย์ที่เปิดเผยในหน้าเว็บได้ (publishable / anon) — ความปลอดภัยจริงอยู่ที่ RLS ในฐานข้อมูล
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# คีย์ลับ: ใช้เฉพาะตัวนำเข้าในเครื่อง (tools/*.mjs) ห้ามส่งให้เบราว์เซอร์
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
